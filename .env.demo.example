# ─────────────────────────────────────────────────────────────
# Hosted demo instance configuration
#
# Copy to .env and start with:
#   docker compose -f docker-compose.yml -f docker-compose.demo.yml up -d
#
# This runs Backslash as a public demo: anyone can sign up and use the full
# editor with real compiles, but accounts are temporary and the expensive
# surfaces are disabled. For a normal self-hosted install, ignore this file
# (DEMO_MODE stays off) and use .env.example instead.
# ─────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────
# Generate with: openssl rand -base64 48
# Do NOT leave the default: on a public host it lets anyone forge a session.
SESSION_SECRET=

APP_URL=https://your-demo-domain.com
SECURE_COOKIES=true
# The whole point of the demo is open signup — leave this false.
DISABLE_SIGNUP=false

# ── Demo behaviour ───────────────────────────────────
# Hours of inactivity before an account, its projects and its files are deleted.
DEMO_TTL_HOURS=2
# Lifetime of a demo session. Keep it >= DEMO_TTL_HOURS.
DEMO_SESSION_HOURS=2
# How often the reaper sweeps for idle accounts.
DEMO_SWEEP_INTERVAL_MINUTES=15

# Compiles allowed per visitor per hour.
DEMO_COMPILES_PER_HOUR=10
# Compiles allowed across the whole instance per day (cost guard).
DEMO_GLOBAL_COMPILES_PER_DAY=500
# Reject builds while the queue is longer than this.
DEMO_MAX_QUEUE_DEPTH=3
# Concurrent builds a single visitor may have queued/running.
DEMO_MAX_CONCURRENT_PER_USER=2
# Hard ceiling on a single compile, regardless of COMPILE_TIMEOUT.
DEMO_MAX_COMPILE_TIMEOUT=60

# Total accounts allowed on the instance.
DEMO_MAX_USERS=2000
# Per-IP abuse limits for account creation and sign-in.
DEMO_SIGNUPS_PER_IP_HOUR=5
DEMO_LOGINS_PER_IP_15MIN=20

# Accounts the reaper never touches — for your own admin/operator account.
# DEMO_EXEMPT_EMAILS=you@example.com

# ── Compile capacity ─────────────────────────────────
# Deliberately lower than the self-hosted defaults.
MAX_CONCURRENT_BUILDS=2
COMPILE_TIMEOUT=45
COMPILE_MEMORY=1g
COMPILE_CPUS=1
ASYNC_COMPILE_MAX_CONCURRENT_BUILDS=1

# Keep the compile runners in the worker process only.
RUN_COMPILE_RUNNER_IN_WEB=false

# ── Optional ─────────────────────────────────────────
# Password reset stays enabled in demo mode. Without SMTP the reset link is
# written to the container log instead of being emailed.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Backslash <no-reply@example.com>"

# To reach the app through a reverse proxy (Dokploy, Coolify, nginx, ...)
# without publishing host ports, uncomment:
# COMPOSE_FILE=docker-compose.yml:docker-compose.demo.yml
